{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogue",
  "description": "The catalogue file of a corpus folder: <folder>/catalogue.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/CatalogueEntry" }
    }
  },
  "$defs": {
    "JsonValue": {
      "description": "Any JSON value."
    },
    "JsonPointer": {
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$"
    },
    "LedgerDependentField": {
      "type": "string",
      "enum": [
        "ledger_number",
        "close_time",
        "previous_ledger_hash",
        "bucket_list_hash",
        "transaction_set_hash",
        "consensus_signature",
        "fee_pool",
        "last_modified_ledger",
        "source_sequence_number",
        "transaction_signature",
        "transaction_hash",
        "ledger_hash",
        "transaction_result_set_hash"
      ]
    },
    "NetworkRefusalResultCode": {
      "type": "string",
      "enum": ["CHANGE_TRUST_MALFORMED"]
    },
    "ReproducedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "value"],
      "properties": {
        "pointer": { "$ref": "#/$defs/JsonPointer" },
        "value": { "$ref": "#/$defs/JsonValue" }
      }
    },
    "LedgerDependentValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "pointer", "value"],
      "properties": {
        "field": { "$ref": "#/$defs/LedgerDependentField" },
        "pointer": { "$ref": "#/$defs/JsonPointer" },
        "value": { "$ref": "#/$defs/JsonValue" }
      }
    },
    "ExpectedDecodedValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reproducedByEveryRun", "ledgerDependent"],
      "properties": {
        "reproducedByEveryRun": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReproducedValue" }
        },
        "ledgerDependent": {
          "type": "array",
          "items": { "$ref": "#/$defs/LedgerDependentValue" }
        }
      }
    },
    "NetworkRefusalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submittedEnvelopeXdr", "resultCode"],
      "properties": {
        "submittedEnvelopeXdr": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "resultCode": { "$ref": "#/$defs/NetworkRefusalResultCode" }
      }
    },
    "CatalogueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cap",
        "protocolVersion",
        "protocolFallback",
        "source",
        "synthetic",
        "expectedDecodedValues",
        "filePath",
        "xdrType",
        "sha256",
        "length"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cap": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "protocolFallback": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "synthetic": { "type": "boolean" },
        "expectedDecodedValues": { "$ref": "#/$defs/ExpectedDecodedValues" },
        "filePath": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$" },
        "xdrType": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "length": { "type": "integer", "minimum": 0 },
        "networkRefusalEvidence": { "$ref": "#/$defs/NetworkRefusalEvidence" }
      },
      "if": {
        "required": ["protocolFallback"],
        "properties": { "protocolFallback": { "const": true } }
      },
      "then": {
        "properties": { "protocolVersion": { "const": 28 } }
      }
    }
  }
}
